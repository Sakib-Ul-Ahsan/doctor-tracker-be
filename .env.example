PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/doctor_tracker?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Initial admin seed credentials (used only by `npm run seed`)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@doctortracker.local
ADMIN_PASSWORD=ChangeMe123!

